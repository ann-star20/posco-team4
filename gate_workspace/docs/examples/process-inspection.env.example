# 호스트별 설계 예시. DIAGNOSIS/ARTIFACT/일부 CONTROL 키는 미구현.
# TCAD_BIND_HOST/PORT와 UNITY_GATEWAY_HTTP_URL은 통신 점검에 사용 가능.
# 실제 .env를 이 파일로 덮어쓰지 말 것.
# Gateway 호스트
DATABASE_URL=
TEST_DATABASE_URL=
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
AOI_MODE=mock
DIAGNOSIS_MODE=mock
TCAD_MODE=mock
UNITY_MODE=mock
TCAD_MOCK_URL=http://127.0.0.1:8100
TCAD_PROD_URL=
ROS_EVENT_TOPIC=/fab/events
ROS_EVENT_ACK_TOPIC=/fab/event_acks
ROS_INFERENCE_REQUEST_TOPIC=/fab/inference_requests
ROS_COMMAND_KEY=
# local은 지정된 용량 내 개발용. s3는 외부 저장소 선정 후 구현/설정.
ARTIFACT_STORE=local
ARTIFACT_LOCAL_ROOT=
ARTIFACT_MAX_TOTAL_BYTES=1073741824
ARTIFACT_MAX_IMAGE_BYTES=20971520
ARTIFACT_S3_ENDPOINT=
ARTIFACT_S3_BUCKET=
ARTIFACT_S3_REGION=
ARTIFACT_S3_ACCESS_KEY_ID=
ARTIFACT_S3_SECRET_ACCESS_KEY=

# Jetson 호스트: 위 DB/저장소 비밀정보를 복사하지 않음
JETSON_PROJECT_PATH=/home/jetson/project/smart_factory
# 카메라는 Jetson 직접 연결 예정. mock은 저장된 원본 이미지를 사용.
CAMERA_MODE=mock
CAMERA_ID=aoi-camera-1
# 카메라 주소와 인증정보를 분리한다. URL에 계정/비밀번호를 넣지 않는다.
CAMERA_SOURCE_URL=https://<camera-host>:8080
CAMERA_AUTH_MODE=basic
CAMERA_USERNAME=
CAMERA_PASSWORD=
CAMERA_TLS_VERIFY=true
CAMERA_TLS_CA_FILE=
CAMERA_ALLOW_HTTP=false
CAMERA_FIXTURE_PATH=
AOI_IMAGE_DIR=/home/jetson/project/smart_factory/jetson_ws/images
CAMERA_CAPTURE_TIMEOUT_SECONDS=10
CAMERA_MAX_FRAME_AGE_MS=1000
CAMERA_CONNECT_TIMEOUT_SECONDS=5
CAMERA_READ_TIMEOUT_SECONDS=5
CAMERA_RECONNECT_INTERVAL_SECONDS=3
CAMERA_CAPTURE_FPS=10
CAMERA_RING_BUFFER_SECONDS=2
CAMERA_RING_BUFFER_MAX_MB=128
CAMERA_PREVIEW_HOST=0.0.0.0
CAMERA_PREVIEW_PORT=8500
CAMERA_PREVIEW_PATH=/camera/preview
CAMERA_PREVIEW_WIDTH=1280
CAMERA_PREVIEW_HEIGHT=720
CAMERA_PREVIEW_FPS=5
CAMERA_PREVIEW_JPEG_QUALITY=75
CAMERA_PREVIEW_MAX_CLIENTS=2
CAMERA_PREVIEW_TOKEN=
CAMERA_REFERENCE_SCRIPT=/home/jetson/project/test/jetson_phone_camera_rec.py
AOI_PART_MODEL_DIR=/home/jetson/project/smart_factory/aoi/models/mosfet_part_v5-26
AOI_DEFECT_MODEL_DIR=/home/jetson/project/smart_factory/aoi/models/mosfet_defect_v5-26
# AOI Worker가 읽는 실제 모델 파일. 호스트별 경로 조정 필요.
AOI_PART_MODEL_FILE=/home/jetson/project/smart_factory/aoi/models/mosfet_part_v5-26/weights/best.pt
AOI_DEFECT_MODEL_FILE=/home/jetson/project/smart_factory/aoi/models/mosfet_defect_v5-26/weights/best.pt
AOI_PIPELINE_CONFIG=
# 이미지 스키마 004, 작업 스키마 005 적용됨. 로컬 writer 구현, 클라우드 백업 후속.
AOI_RESULT_DIR=/home/jetson/project/smart_factory/result/aoi
AOI_RUNTIME_DB=/home/jetson/project/smart_factory/result/aoi.sqlite
AOI_FRAME_SPOOL_DIR=/home/jetson/project/smart_factory/result/aoi-frame-spool
AOI_QUEUE_SIZE=10
AOI_EXECUTOR_WORKERS=1
AOI_COMPLETION_WAIT_SECONDS=30
AOI_UNITY_WS_HOST=0.0.0.0
AOI_UNITY_WS_PORT=8400
AOI_UNITY_TOKEN=
AOI_UNITY_MAX_IMAGE_BYTES=8388608
AOI_ROS_PERSISTENCE_ENABLED=true
AOI_DEVICE_ID=jetson-1
AOI_INFER_DEVICE=cpu
AOI_PART_CONF_THRESHOLD=0.35
AOI_DEFECT_CONF_THRESHOLD=0.20
AOI_PART_IOU_THRESHOLD=0.45
AOI_DEFECT_IOU_THRESHOLD=0.35
AOI_CLOUD_BACKUP_ENABLED=false
DIAGNOSIS_MODEL_FILE=
INFERENCE_MAX_CONCURRENCY=1
GATEWAY_ARTIFACT_BASE_URL=
WORKER_API_TOKEN=

# Unity 시험 클라이언트 호스트
UNITY_GATEWAY_WS_URL=ws://127.0.0.1:8000/api/v1/stream
UNITY_GATEWAY_CONTROL_WS_URL=ws://127.0.0.1:8000/api/v1/control
UNITY_GATEWAY_HTTP_URL=http://127.0.0.1:8000
UNITY_API_TOKEN=
FAB_RUN_ID=

# TCAD mock/서비스 호스트의 바인드 설정: 구현됨
TCAD_BIND_HOST=127.0.0.1
TCAD_BIND_PORT=8100
