# Copy to /home/jetson/project/smart_factory/.env.ml-prod and source after the common .env.
SURROGATE_MODE=prod
SURROGATE_PROD_URL=http://127.0.0.1:8300
SURROGATE_TIMEOUT_SECONDS=30
SURROGATE_RUNTIME_DB=/home/jetson/project/smart_factory/data/surrogate.sqlite

DIAGNOSIS_MODE=prod
DIAGNOSIS_PROD_URL=http://127.0.0.1:8300
DIAGNOSIS_TIMEOUT_SECONDS=30
DIAGNOSIS_RUNTIME_DB=/home/jetson/project/smart_factory/data/diagnosis.sqlite

ROS_SURROGATE_REQUEST_TOPIC=/fab/surrogate_requests
ROS_DIAGNOSIS_REQUEST_TOPIC=/fab/diagnosis_requests
ROS_EVENT_TOPIC=/fab/events
ROS_EVENT_ACK_TOPIC=/fab/event_acks
