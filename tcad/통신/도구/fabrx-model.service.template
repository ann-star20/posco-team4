[Unit]
Description=FabRx model service (surrogate + diagnosis, contract fab-ml-v1)
After=network.target

[Service]
Type=simple
User=@USER@
WorkingDirectory=@DIR@
Environment=LANG=C.UTF-8
Environment=LC_ALL=C.UTF-8
Environment=PYTHONUNBUFFERED=1
# 토큰을 쓰려면 /etc/fabrx/service.env 에 FAB_SERVICE_TOKEN=영문토큰 을 적는다 (파일이 없어도 시작된다)
EnvironmentFile=-/etc/fabrx/service.env
ExecStart=@PYTHON@ @DIR@/run_service.py --log-file /var/log/fabrx/model-service.log
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
