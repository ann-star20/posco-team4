# 한 PC WSL용 AOI → mock Unity 직접 WebSocket 시험. 비밀값을 넣지 않는다.
AOI_MODE=prod
CAMERA_MODE=mock
JETSON_PROJECT_PATH=/mnt/c/posco_project/jetson_ws
AOI_IMAGE_DIR=/mnt/c/posco_project/jetson_ws/images
CAMERA_FIXTURE_PATH=/mnt/c/posco_project/jetson_ws/images/test_aoi_mosfet1.jpg
AOI_RESULT_DIR=/mnt/c/posco_project/jetson_ws/result/unity-direct-test
AOI_PART_MODEL_FILE=/mnt/c/posco_project/jetson_ws/models/mosfet_part_v5-26/weights/best.pt
AOI_DEFECT_MODEL_FILE=/mnt/c/posco_project/jetson_ws/models/mosfet_defect_v5-26/weights/best.pt
AOI_INFER_DEVICE=cpu
AOI_PART_CONF_THRESHOLD=0.35
AOI_DEFECT_CONF_THRESHOLD=0.20
AOI_PART_IOU_THRESHOLD=0.45
AOI_DEFECT_IOU_THRESHOLD=0.35
AOI_DEVICE_ID=wsl-jetson-test
AOI_UNITY_WS_HOST=0.0.0.0
AOI_UNITY_WS_PORT=8400
AOI_UNITY_TOKEN=aoi-unity-local-test
AOI_UNITY_MAX_IMAGE_BYTES=8388608
AOI_ROS_PERSISTENCE_ENABLED=false
AOI_UNITY_TEST_FIXTURE=test_aoi_mosfet1.jpg
AOI_UNITY_TEST_OUTPUT=/mnt/c/posco_project/data/aoi-unity-test
