TCAD_MODE=mock
UNITY_MODE=mock
TCAD_MOCK_URL=http://127.0.0.1:8100
TCAD_PROD_URL=
TCAD_MOCK_SCENARIO=pass
TCAD_MOCK_SEED=42
# mock 또는 workstation 서비스 실행 호스트의 바인드 값. 원격 시험 시 호스트를 지정.
TCAD_BIND_HOST=127.0.0.1
TCAD_BIND_PORT=8100
TCAD_HTTP_TIMEOUT_SECONDS=10
TCAD_POLL_INTERVAL_SECONDS=5
# 실제 Gateway와 테스트 모두 Aiven을 쓸 수 있다. 비밀값은 이 예시 파일에 넣지 않는다.
# Aiven URI에는 sslmode=require를 포함한다. 테스트는 고유 임시 스키마를 사용한다.
DATABASE_URL=
TEST_DATABASE_URL=
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
APPROVAL_OPERATOR=
APPROVAL_TOKEN=
UNITY_GATEWAY_WS_URL=ws://127.0.0.1:8000/api/v1/stream
UNITY_GATEWAY_HTTP_URL=http://127.0.0.1:8000
ROS_EVENT_TOPIC=/fab/events
ROS_EVENT_ACK_TOPIC=/fab/event_acks
ROS_COMMAND_TOPIC=/fab/commands
ROS_COMMAND_KEY=
JETSON_HOST=
JETSON_USER=
JETSON_PASSWORD=
JETSON_PROJECT_PATH=/home/jetson/project/smart_factory

# 모델 추론 HTTP adapter는 Jetson Worker가 호출한다. mock/prod 모두 같은 계약.
SURROGATE_MODE=mock
SURROGATE_MOCK_URL=http://127.0.0.1:8300
SURROGATE_PROD_URL=
SURROGATE_BIND_HOST=127.0.0.1
SURROGATE_BIND_PORT=8300
SURROGATE_TIMEOUT_SECONDS=15
SURROGATE_RUNTIME_DB=data/surrogate.sqlite
ROS_SURROGATE_REQUEST_TOPIC=/fab/surrogate_requests
ROS_DIAGNOSIS_REQUEST_TOPIC=/fab/diagnosis_requests
DIAGNOSIS_MODE=mock
DIAGNOSIS_MOCK_URL=http://127.0.0.1:8300
# DIAGNOSIS_PROD_URL=http://127.0.0.1:8300
ROS_INFERENCE_REQUEST_TOPIC=/fab/inference_requests
CORRECTION_TARGET=unity
UNITY_API_TOKEN=
UNITY_GATEWAY_COMMAND_WS_URL=ws://127.0.0.1:8000/api/v1/commands
UNITY_MOCK_DB_PATH=data/mock-unity.sqlite
# WSL 환경에서 검증한 프로필의 절대 경로. Jetson에는 이 WSL 경로를 복사하지 않음.
ROS_TEST_PROFILE=
RUN_EDGE_WORKERS=true
START_LOCAL_MOCK_SERVICES=true

# 선택 기능: Jetson AOI 결과를 Unity에 직접 전송한다. 기존 Gateway/Aiven E2E와 별도다.
# AOI_UNITY_DIRECT_ENABLED=false
# AOI_UNITY_WS_HOST=0.0.0.0
# AOI_UNITY_WS_PORT=8400
# AOI_UNITY_TOKEN=
# AOI_UNITY_MAX_IMAGE_BYTES=8388608
# AOI_ROS_PERSISTENCE_ENABLED=true
# AOI_RUNTIME_DB=/home/jetson/project/smart_factory/data/aoi-unity.sqlite
# AOI_INFER_PRECISION=fp32

# Jetson 카메라 Preview + frame_id 기반 AOI. 실제 계정과 비밀번호는 로컬 .env에만 둔다.
# CAMERA_MODE=mock
# CAMERA_ID=aoi-camera-1
# CAMERA_FIXTURE_PATH=/home/jetson/project/smart_factory/jetson_ws/images/test_aoi_mosfet1.jpg
